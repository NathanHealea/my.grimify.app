{
  "name": "grimify",
  "private": true,
  "version": "0.19.4",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@clerk/react": "6.17.6",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@tanstack/react-router": "1.170.41",
    "convex": "1.46.0",
    "culori": "4.0.2",
    "fuse.js": "7.5.0",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.52.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@clerk/testing": "2.2.44",
    "@edge-runtime/vm": "5.0.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "convex-test": "0.0.60",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "trap 'kill 0' EXIT; convex dev & vite",
    "build": "npm run catalog:build && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test && npm run catalog:validate",
    "catalog:validate": "node scripts/build-catalog.ts --validate",
    "catalog:build": "node scripts/build-catalog.ts --build",
    "catalog:ids": "node scripts/build-catalog.ts --record-ids",
    "deploy:dev": "node scripts/deploy.ts dev",
    "deploy:stage": "node scripts/deploy.ts stage",
    "deploy:prod": "node scripts/deploy.ts prod"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
